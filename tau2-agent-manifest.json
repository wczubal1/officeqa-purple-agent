{
  "manifest_version": "1.0.0",
  "components": {
    "agent": {
      "image": "ghcr.io/wczubal1/tau2-purple-agent:latest",
      "entrypoint": "python -m src.agent.server",
      "env": {
        "OPENAI_API_KEY": "${secrets.OPENAI_API_KEY}",
        "TAU2_AGENT_LLM": "openai/gpt-4.1"
      },
      "network": {
        "port": 9019
      }
    }
  },
  "metadata": {
    "name": "Tau2 Purple Agent",
    "version": "1.0.0",
    "description": "Purple agent for tau2-bench customer service evaluation"
  }
}