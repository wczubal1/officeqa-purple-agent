{
  "manifest_version": "0.1.0",
  "program": {
    "image": "ghcr.io/wczubal1/officeqa-purple-agent:latest"
  },
  "slots": {
    "openai_api_key": {
      "kind": "secret",
      "description": "OpenAI API key"
    }
  },
  "provides": {
    "a2a": {
      "kind": "a2a",
      "protocol": "A2A",
      "version": "1.0.0"
    }
  },
  "exports": {
    "a2a": "a2a"
  },
  "metadata": {
    "name": "OfficeQA Purple Agent",
    "version": "1.0.0",
    "description": "Purple agent for OfficeQA benchmark",
    "author": "witold"
  }
}

